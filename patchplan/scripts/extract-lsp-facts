#!/usr/bin/env python3
import json
import os
import select
import shutil
import subprocess
import sys
import time
from pathlib import Path
from urllib.parse import unquote, urlparse


KIND_NAMES = {
    1: "file",
    2: "module",
    3: "namespace",
    4: "package",
    5: "class",
    6: "method",
    7: "property",
    8: "field",
    9: "constructor",
    10: "enum",
    11: "interface",
    12: "function",
    13: "variable",
    14: "constant",
    15: "string",
    16: "number",
    17: "boolean",
    18: "array",
    19: "object",
    20: "key",
    21: "null",
    22: "enumMember",
    23: "struct",
    24: "event",
    25: "operator",
    26: "typeParameter",
}


class LSPClient:
    def __init__(self, server, root):
        self.root = root
        self.proc = subprocess.Popen(
            [server, "--stdio", "--log-level", "1"],
            cwd=root,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        self.next_id = 1
        self.diagnostics = {}
        self.errors = []

    def close(self):
        if self.proc.poll() is None:
            try:
                self.proc.terminate()
                self.proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                self.proc.kill()

    def send(self, payload):
        raw = json.dumps(payload, separators=(",", ":")).encode("utf-8")
        header = f"Content-Length: {len(raw)}\r\n\r\n".encode("ascii")
        self.proc.stdin.write(header + raw)
        self.proc.stdin.flush()

    def notify(self, method, params=None):
        self.send({"jsonrpc": "2.0", "method": method, "params": params or {}})

    def request(self, method, params=None):
        req_id = self.next_id
        self.next_id += 1
        self.send({"jsonrpc": "2.0", "id": req_id, "method": method, "params": params or {}})
        return req_id

    def respond(self, req_id, result=None):
        self.send({"jsonrpc": "2.0", "id": req_id, "result": result})

    def read_message(self, timeout=2.0):
        if self.proc.poll() is not None:
            return None
        ready, _, _ = select.select([self.proc.stdout], [], [], timeout)
        if not ready:
            return None

        headers = {}
        while True:
            line = self.proc.stdout.readline()
            if not line:
                return None
            if line in (b"\r\n", b"\n"):
                break
            key, _, value = line.decode("ascii", errors="replace").partition(":")
            headers[key.lower()] = value.strip()

        length = int(headers.get("content-length", "0"))
        if length <= 0:
            return None
        body = self.proc.stdout.read(length)
        return json.loads(body.decode("utf-8"))

    def pump(self, until_id=None, timeout=5.0):
        deadline = time.monotonic() + timeout
        wanted = None
        while time.monotonic() < deadline:
            msg = self.read_message(max(0.05, deadline - time.monotonic()))
            if msg is None:
                continue
            if "method" in msg and msg.get("method") == "textDocument/publishDiagnostics":
                params = msg.get("params", {})
                self.diagnostics[params.get("uri", "")] = params.get("diagnostics", [])
            elif "method" in msg and "id" in msg:
                self.respond(msg["id"], None)
            elif until_id is not None and msg.get("id") == until_id:
                wanted = msg
                break
            elif "error" in msg:
                self.errors.append(msg["error"])
        return wanted


def uri_for(path):
    return path.resolve().as_uri()


def path_from_uri(uri):
    parsed = urlparse(uri)
    return Path(unquote(parsed.path))


def rel_file(root, path):
    try:
        return str(path.resolve().relative_to(root.resolve()))
    except ValueError:
        return str(path)


def position_label(root, uri, pos):
    path = rel_file(root, path_from_uri(uri))
    return f"{path}:{int(pos.get('line', 0)) + 1}:{int(pos.get('character', 0))}"


def node_id(kind, file_name, line, character, name):
    return f"{kind}:{file_name}:{line}:{character}:{name}"


def severity(value):
    return {1: "error", 2: "warning", 3: "info", 4: "info"}.get(value, "info")


def diagnostic_code(code):
    if code is None:
        return ""
    text = str(code)
    if text.isdigit():
        return f"TS{text}"
    return text


def flatten_symbols(items, file_name):
    out = []
    for item in items or []:
        name = item.get("name")
        kind_value = item.get("kind")
        if name:
            out.append({
                "name": name,
                "kind": KIND_NAMES.get(kind_value, str(kind_value)),
                "file": file_name,
            })
        out.extend(flatten_symbols(item.get("children", []), file_name))
    return out


def semantic_symbols(items, file_name):
    out = []
    for item in items or []:
        name = item.get("name")
        kind_value = item.get("kind")
        start = item.get("selectionRange", item.get("range", {})).get("start", {})
        if name:
            line = int(start.get("line", 0)) + 1
            character = int(start.get("character", 0))
            symbol_kind = KIND_NAMES.get(kind_value, str(kind_value))
            out.append({
                "id": node_id("symbol", file_name, line, character, name),
                "kind": "symbol",
                "name": name,
                "symbolKind": symbol_kind,
                "file": file_name,
                "line": line,
                "character": character,
            })
        out.extend(semantic_symbols(item.get("children", []), file_name))
    return out


def find_first_logger_usage(path):
    if not path.exists():
        return None
    for line_no, line in enumerate(path.read_text().splitlines()):
        start = 0
        while True:
            idx = line.find("logger", start)
            if idx == -1:
                break
            before = line[idx - 1] if idx > 0 else ""
            after = line[idx + len("logger")] if idx + len("logger") < len(line) else ""
            if not (before.isidentifier() or before == "_") and not (after.isidentifier() or after == "_"):
                if "import" not in line[:idx]:
                    return {"line": line_no, "character": idx}
            start = idx + len("logger")
    return None


def normalize_diagnostics(root, diagnostics_by_uri):
    out = []
    for uri, diagnostics in diagnostics_by_uri.items():
        file_name = rel_file(root, path_from_uri(uri))
        for diag in diagnostics:
            start = diag.get("range", {}).get("start", {})
            out.append({
                "file": file_name,
                "line": int(start.get("line", 0)) + 1,
                "character": int(start.get("character", 0)),
                "severity": severity(diag.get("severity", 3)),
                "code": diagnostic_code(diag.get("code")),
                "message": diag.get("message", ""),
            })
    return out


def diagnostic_semantic(diagnostics, semantic_nodes):
    nodes = []
    edges = []
    ref_ids = {
        (n.get("file"), n.get("line"), n.get("character"), n.get("name")): n.get("id")
        for n in semantic_nodes
        if n.get("kind") == "reference"
    }
    ref_ids_by_line = {
        (n.get("file"), n.get("line"), n.get("name")): n.get("id")
        for n in semantic_nodes
        if n.get("kind") == "reference"
    }
    for diag in diagnostics:
        file_name = diag.get("file", "")
        line = int(diag.get("line", 0))
        character = int(diag.get("character", 0))
        code = diag.get("code") or "diagnostic"
        message = diag.get("message", "")
        diag_node = {
            "id": node_id("diagnostic", file_name, line, character, code),
            "kind": "diagnostic",
            "name": code,
            "code": code,
            "message": message,
            "file": file_name,
            "line": line,
            "character": character,
        }
        nodes.append(diag_node)
        if code == "TS2304" and "logger" in message:
            ref_id = ref_ids.get((file_name, line, character, "logger"))
            if not ref_id:
                ref_id = ref_ids_by_line.get((file_name, line, "logger"))
            if ref_id:
                edges.append({
                    "from": diag_node["id"],
                    "to": ref_id,
                    "kind": "diagnoses",
                })
    return nodes, edges


def write_payload(output, phase, ok, diagnostics, symbols=None, references=None, semantic_nodes=None, semantic_edges=None):
    payload = {
        "lsp": {
            "phase": phase,
            "adapterOK": ok,
            "errorCount": sum(1 for d in diagnostics if d.get("severity") == "error"),
            "diagnostics": diagnostics,
            "symbols": symbols or [],
            "references": references or [],
            "semanticNodes": semantic_nodes or [],
            "semanticEdges": semantic_edges or [],
        }
    }
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps(payload, indent=2) + "\n")


def main():
    if len(sys.argv) != 4 or sys.argv[1] not in ("live", "candidate"):
        raise SystemExit("usage: extract-lsp-facts live|candidate <source-root> <output-file>")
    phase, source_root, output = sys.argv[1:]
    root = Path(source_root).resolve()
    out = Path(output)
    server = shutil.which("typescript-language-server")
    if not server:
        write_payload(out, phase, False, [{"severity": "error", "message": "typescript-language-server not found"}])
        return

    client = LSPClient(server, root)
    symbols = []
    references = []
    semantic_nodes = []
    semantic_edges = []
    try:
        init_id = client.request("initialize", {
            "processId": os.getpid(),
            "rootUri": uri_for(root),
            "workspaceFolders": [{"uri": uri_for(root), "name": root.name}],
            "capabilities": {
                "textDocument": {
                    "documentSymbol": {"dynamicRegistration": False, "hierarchicalDocumentSymbolSupport": True},
                    "references": {"dynamicRegistration": False},
                    "publishDiagnostics": {"relatedInformation": False},
                    "synchronization": {"didOpen": True},
                },
                "workspace": {"workspaceFolders": True},
            },
            "initializationOptions": {},
        })
        init_response = client.pump(init_id, timeout=8.0)
        if not init_response or init_response.get("error"):
            message = init_response.get("error", {}).get("message", "initialize failed") if init_response else "initialize timed out"
            write_payload(out, phase, False, [{"severity": "error", "message": message}])
            return
        client.notify("initialized", {})

        docs = [root / "src" / "app.ts"]
        logger_path = root / "src" / "logger.ts"
        if logger_path.exists():
            docs.append(logger_path)

        for doc in docs:
            client.notify("textDocument/didOpen", {
                "textDocument": {
                    "uri": uri_for(doc),
                    "languageId": "typescript",
                    "version": 1,
                    "text": doc.read_text(),
                }
            })
        client.pump(timeout=1.5)

        for doc in docs:
            sym_id = client.request("textDocument/documentSymbol", {"textDocument": {"uri": uri_for(doc)}})
            response = client.pump(sym_id, timeout=6.0)
            if response and not response.get("error"):
                result = response.get("result", [])
                file_name = rel_file(root, doc)
                symbols.extend(flatten_symbols(result, file_name))
                semantic_nodes.extend(semantic_symbols(result, file_name))

        usage = find_first_logger_usage(root / "src" / "app.ts")
        if usage:
            from_file = "src/app.ts"
            from_line = usage["line"] + 1
            from_character = usage["character"]
            from_node = {
                "id": node_id("ref", from_file, from_line, from_character, "logger"),
                "kind": "reference",
                "name": "logger",
                "file": from_file,
                "line": from_line,
                "character": from_character,
            }
            semantic_nodes.append(from_node)
            ref_id = client.request("textDocument/references", {
                "textDocument": {"uri": uri_for(root / "src" / "app.ts")},
                "position": usage,
                "context": {"includeDeclaration": True},
            })
            response = client.pump(ref_id, timeout=6.0)
            if response and not response.get("error"):
                symbol_ids = {
                    (n["file"], n["line"], n["character"], n.get("name")): n["id"]
                    for n in semantic_nodes
                    if n.get("kind") == "symbol"
                }
                from_pos = f"{from_file}:{from_line}:{from_character}"
                for loc in response.get("result") or []:
                    target_uri = loc.get("uri", "")
                    target_start = loc.get("range", {}).get("start", {})
                    target_file = rel_file(root, path_from_uri(target_uri))
                    target_line = int(target_start.get("line", 0)) + 1
                    target_character = int(target_start.get("character", 0))
                    references.append({
                        "from": from_pos,
                        "to": position_label(root, target_uri, target_start),
                    })
                    ref_node = {
                        "id": node_id("ref", target_file, target_line, target_character, "logger"),
                        "kind": "reference",
                        "name": "logger",
                        "file": target_file,
                        "line": target_line,
                        "character": target_character,
                    }
                    semantic_nodes.append(ref_node)
                    target_symbol_id = symbol_ids.get((target_file, target_line, target_character, "logger"))
                    if target_symbol_id:
                        semantic_edges.append({
                            "from": from_node["id"],
                            "to": target_symbol_id,
                            "kind": "resolves-to",
                        })

        client.pump(timeout=1.5)
        diagnostics = normalize_diagnostics(root, client.diagnostics)
        diagnostic_nodes, diagnostic_edges = diagnostic_semantic(diagnostics, semantic_nodes)
        semantic_nodes.extend(diagnostic_nodes)
        semantic_edges.extend(diagnostic_edges)
        deduped_nodes = list({n["id"]: n for n in semantic_nodes}.values())
        deduped_edges = list({(e["from"], e["to"], e["kind"]): e for e in semantic_edges}.values())
        write_payload(out, phase, True, diagnostics, symbols, references, deduped_nodes, deduped_edges)

        shutdown_id = client.request("shutdown")
        client.pump(shutdown_id, timeout=2.0)
        client.notify("exit")
    except Exception as exc:
        write_payload(out, phase, False, [{"severity": "error", "message": str(exc)}], symbols, references, semantic_nodes, semantic_edges)
    finally:
        client.close()


if __name__ == "__main__":
    main()
