#!/usr/bin/env bash
set -euo pipefail

mode="${1:-good}"
live_root="patchplan/out/live/source"
candidate_root="patchplan/out/candidate/source"

if [ "$mode" != "good" ] && [ "$mode" != "bad" ]; then
  printf 'usage: patchplan/scripts/make-candidate [good|bad]\n' >&2
  exit 2
fi

rm -rf "$candidate_root"
mkdir -p "$candidate_root"
cp -R "$live_root"/. "$candidate_root"/

python3 - "$candidate_root/package.json" <<'PY'
from pathlib import Path
import json
import sys
path = Path(sys.argv[1])
data = json.loads(path.read_text())
data.pop("type", None)
path.write_text(json.dumps(data, indent=2) + "\n")
PY

if [ "$mode" = "good" ]; then
  python3 - "$candidate_root/src/app.ts" <<'PY'
from pathlib import Path
import sys
path = Path(sys.argv[1])
text = path.read_text()
text = 'import { logger } from "./logger"\n\n' + text
text = text.replace("console.log", "logger.log").replace("console.error", "logger.error")
path.write_text(text)
PY
  cat > "$candidate_root/src/logger.ts" <<'EOF'
export const logger = {
  log: (...args: unknown[]) => console.log(...args),
  error: (...args: unknown[]) => console.error(...args),
}
EOF
else
  python3 - "$candidate_root/src/app.ts" <<'PY'
from pathlib import Path
import sys
path = Path(sys.argv[1])
path.write_text(path.read_text().replace("console.log", "logger.log"))
PY
fi
