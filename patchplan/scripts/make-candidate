#!/usr/bin/env bash
set -euo pipefail

mode="${1:-good}"
live_root="patchplan/out/live/source"
candidate_root="patchplan/out/candidate/source"

if [ "$mode" != "good" ] && [ "$mode" != "bad" ]; then
  printf 'usage: patchplan/scripts/make-candidate [good|bad]\n' >&2
  exit 2
fi

rm -rf "$candidate_root"
mkdir -p "$candidate_root"
cp -R "$live_root"/. "$candidate_root"/

python3 - "$candidate_root/package.json" <<'PY'
from pathlib import Path
import json
import sys
path = Path(sys.argv[1])
data = json.loads(path.read_text())
data.pop("type", None)
path.write_text(json.dumps(data, indent=2) + "\n")
PY

if [ "$mode" = "good" ]; then
  python3 - "$candidate_root/src" <<'PY'
from pathlib import Path
import sys
src = Path(sys.argv[1])
for path in sorted(src.rglob("*.ts")):
    if path.name == "logger.ts":
        continue
    text = path.read_text()
    if "console.log" not in text and "console.error" not in text:
        continue
    text = text.replace("console.log", "logger.log").replace("console.error", "logger.error")
    rel_logger = Path("logger")
    if path.parent != src:
        rel_logger = Path(*([".."] * len(path.parent.relative_to(src).parts)), "logger")
    import_line = f'import {{ logger }} from "./{rel_logger.as_posix()}"\n\n'
    if 'import { logger } from ' not in text:
        text = import_line + text
    path.write_text(text)
PY
  cat > "$candidate_root/src/logger.ts" <<'EOF'
export const logger = {
  log: (...args: unknown[]) => console.log(...args),
  error: (...args: unknown[]) => console.error(...args),
}
EOF
else
  python3 - "$candidate_root/src" <<'PY'
from pathlib import Path
import sys
src = Path(sys.argv[1])
for path in sorted(src.rglob("*.ts")):
    if path.name == "logger.ts":
        continue
    path.write_text(path.read_text().replace("console.log", "logger.log"))
PY
fi
