#!/usr/bin/env python3
import json
import sys
from pathlib import Path


def esc(value):
    return str(value).replace("\\", "\\\\").replace('"', '\\"')


def main():
    if len(sys.argv) != 3:
        raise SystemExit("usage: graph-dot <graph.json> <deps.dot>")
    graph = json.loads(Path(sys.argv[1]).read_text())
    lines = ["digraph patchplan {", "  rankdir=LR;"]
    for node in graph.get("nodes", []):
        lines.append(f'  "{esc(node["id"])}" [label="{esc(node["label"])}", shape=box];')
    for edge in graph.get("edges", []):
        label = edge.get("label", edge.get("kind", ""))
        lines.append(f'  "{esc(edge["from"])}" -> "{esc(edge["to"])}" [label="{esc(label)}"];')
    lines.append("}")
    out = Path(sys.argv[2])
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text("\n".join(lines) + "\n")


if __name__ == "__main__":
    main()
