#!/usr/bin/env bash
set -euo pipefail

tmp="${TMPDIR:-/tmp}/patchplan-tamper-matrix.$$"
out="patchplan/out/reports/tamper-matrix"
trap 'rm -rf "$tmp"' EXIT

mkdir -p "$tmp/good" "$tmp/bad"

copy_artifacts() {
  local dest="$1"
  mkdir -p "$dest"
  cp patchplan/out/reports/report.json "$dest/report.json"
  cp patchplan/out/reports/report-input.json "$dest/report-input.json"
  cp patchplan/out/candidate/compiler.json "$dest/compiler.json"
  cp patchplan/out/candidate/lsp.json "$dest/lsp.json"
  cp patchplan/out/graph/graph.json "$dest/graph.json"
}

patchplan/scripts/demo good >/dev/null 2>&1
copy_artifacts "$tmp/good"

patchplan/scripts/demo bad >/dev/null 2>&1
copy_artifacts "$tmp/bad"

mkdir -p "$out/cases"

python3 - "$tmp" "$out/cases" <<'PY'
import json
import sys
from pathlib import Path

tmp = Path(sys.argv[1])
cases = Path(sys.argv[2])

def load(path):
    return json.loads(path.read_text())

def write(name, data):
    path = cases / f"{name}.json"
    path.write_text(json.dumps(data, indent=2) + "\n")
    return path

bad_report = load(tmp / "bad" / "report.json")
bad_report["report"]["accepted"] = True
write("bad-facts-accepted-true", bad_report)

good_report = load(tmp / "good" / "report.json")
good_report["report"]["accepted"] = False
write("good-facts-accepted-false", good_report)

lsp = load(tmp / "good" / "lsp.json")
lsp["lsp"]["errorCount"] = 0
lsp["lsp"]["diagnostics"] = [{
    "file": "src/app.ts",
    "line": 1,
    "character": 0,
    "severity": "error",
    "code": "TSTAMPER",
    "message": "tampered diagnostic",
}]
write("lsp-diagnostics-errorcount-zero", lsp)

compiler = load(tmp / "good" / "compiler.json")
compiler["compiler"]["errorCount"] = 0
compiler["compiler"]["diagnostics"] = [{
    "file": "src/app.ts",
    "line": 1,
    "severity": "error",
    "code": "TSTAMPER",
    "message": "tampered compiler diagnostic",
}]
write("compiler-diagnostics-errorcount-zero", compiler)

graph_report = {
    "graph": load(tmp / "bad" / "graph.json"),
    "report": load(tmp / "good" / "report.json")["report"],
}
graph_report["report"]["accepted"] = True
write("graph-diagnostic-accepted-true", graph_report)

diff_report = load(tmp / "good" / "report.json")
diff_report["report"]["candidate"]["diffNonEmpty"] = False
diff_report["report"]["accepted"] = True
write("diff-empty-accepted-true", diff_report)

unresolved_report = load(tmp / "good" / "report.json")
unresolved_report["report"]["candidate"]["allLoggerReferencesResolved"] = False
unresolved_report["report"]["accepted"] = True
write("logger-unresolved-accepted-true", unresolved_report)
PY

run_case() {
  local name="$1"
  shift
  local log="$out/cases/$name.log"
  if "$@" >"$log" 2>&1; then
    printf '%s: unexpected-pass\n' "$name"
    return 1
  fi
  printf '%s: rejected\n' "$name"
}

results="$out/failure-domain.txt"
: > "$results"

{
  run_case bad-facts-accepted-true cue vet patchplan/cue/schema.cue patchplan/cue/accept.cue "$out/cases/bad-facts-accepted-true.json"
  run_case good-facts-accepted-false cue vet patchplan/cue/schema.cue patchplan/cue/accept.cue "$out/cases/good-facts-accepted-false.json"
  run_case lsp-diagnostics-errorcount-zero cue vet patchplan/cue/schema.cue "$out/cases/lsp-diagnostics-errorcount-zero.json"
  run_case compiler-diagnostics-errorcount-zero cue vet patchplan/cue/schema.cue "$out/cases/compiler-diagnostics-errorcount-zero.json"
  run_case graph-diagnostic-accepted-true cue vet patchplan/cue/schema.cue patchplan/cue/integrity.cue "$out/cases/graph-diagnostic-accepted-true.json"
  run_case diff-empty-accepted-true cue vet patchplan/cue/schema.cue patchplan/cue/accept.cue "$out/cases/diff-empty-accepted-true.json"
  run_case logger-unresolved-accepted-true cue vet patchplan/cue/schema.cue patchplan/cue/accept.cue "$out/cases/logger-unresolved-accepted-true.json"
} | tee "$results"

python3 - "$results" "$out/failure-domain.json" "$out/failure-domain.md" <<'PY'
import json
import sys
from pathlib import Path

results_path, json_path, md_path = map(Path, sys.argv[1:])
rows = []
for line in results_path.read_text().splitlines():
    name, status = line.split(": ", 1)
    rows.append({"case": name, "status": status})
accepted = all(row["status"] == "rejected" for row in rows)
payload = {
    "slice": "tamper-matrix",
    "tier": "failure-domain",
    "accepted": accepted,
    "cases": rows,
}
json_path.write_text(json.dumps(payload, indent=2) + "\n")
md_path.write_text(
    "\n".join([
        "# Tamper Matrix",
        "",
        f"- tier: failure-domain",
        f"- accepted: {str(accepted).lower()}",
        *[f"- {row['case']}: {row['status']}" for row in rows],
        "",
    ])
)
if not accepted:
    raise SystemExit(1)
PY
