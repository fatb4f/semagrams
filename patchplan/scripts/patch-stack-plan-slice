#!/usr/bin/env bash
set -euo pipefail

tmp="${TMPDIR:-/tmp}/patchplan-patch-stack-plan.$$"
out="patchplan/out/reports"
trap 'rm -rf "$tmp"' EXIT

mkdir -p "$tmp" "$out"

python3 - "$tmp" <<'PY'
import json
import sys
from pathlib import Path

root = Path(sys.argv[1])

fixtures = {
    "good": [
        {
            "id": "001-symbol-private-leaf",
            "scope": "symbol",
            "operation": "rename",
            "touches": ["src/domain.ts#privateName"],
            "dependsOn": [],
            "order": 1,
            "evidence": {"syntax": "synthetic"},
        },
        {
            "id": "002-file-local-adapter",
            "scope": "file",
            "operation": "adapt",
            "touches": ["src/domain.ts"],
            "dependsOn": ["001-symbol-private-leaf"],
            "order": 2,
            "evidence": {"syntax": "synthetic"},
        },
        {
            "id": "003-package-boundary",
            "scope": "package",
            "operation": "adapt",
            "touches": ["src/index.ts"],
            "dependsOn": ["002-file-local-adapter"],
            "order": 3,
            "evidence": {"syntax": "synthetic"},
        },
        {
            "id": "004-workspace-integration",
            "scope": "workspace",
            "operation": "adapt",
            "touches": ["tsconfig.json"],
            "dependsOn": ["003-package-boundary"],
            "order": 4,
            "evidence": {"syntax": "synthetic"},
        },
    ],
    "top-down": [
        {
            "id": "001-workspace-integration",
            "scope": "workspace",
            "operation": "adapt",
            "touches": ["tsconfig.json"],
            "dependsOn": ["002-package-boundary"],
            "order": 1,
        },
        {
            "id": "002-package-boundary",
            "scope": "package",
            "operation": "adapt",
            "touches": ["src/index.ts"],
            "dependsOn": ["003-file-local-adapter"],
            "order": 2,
        },
        {
            "id": "003-file-local-adapter",
            "scope": "file",
            "operation": "adapt",
            "touches": ["src/domain.ts"],
            "dependsOn": ["004-symbol-private-leaf"],
            "order": 3,
        },
        {
            "id": "004-symbol-private-leaf",
            "scope": "symbol",
            "operation": "rename",
            "touches": ["src/domain.ts#privateName"],
            "dependsOn": [],
            "order": 4,
        },
    ],
    "forward-dependency": [
        {
            "id": "001-symbol-private-leaf",
            "scope": "symbol",
            "operation": "rename",
            "touches": ["src/domain.ts#privateName"],
            "dependsOn": ["002-file-local-adapter"],
            "order": 1,
        },
        {
            "id": "002-file-local-adapter",
            "scope": "file",
            "operation": "adapt",
            "touches": ["src/domain.ts"],
            "dependsOn": [],
            "order": 2,
        },
    ],
    "scope-inversion": [
        {
            "id": "001-workspace-integration",
            "scope": "workspace",
            "operation": "adapt",
            "touches": ["tsconfig.json"],
            "dependsOn": ["002-symbol-private-leaf"],
            "order": 1,
        },
        {
            "id": "002-symbol-private-leaf",
            "scope": "symbol",
            "operation": "rename",
            "touches": ["src/domain.ts#privateName"],
            "dependsOn": [],
            "order": 2,
        },
    ],
}

ranks = {
    "symbol": 10,
    "file": 20,
    "package": 30,
    "module": 40,
    "workspace": 50,
}

def validate(steps):
    by_id = {step["id"]: step for step in steps}
    ids = [step["id"] for step in steps]
    duplicate_ids = sorted({step_id for step_id in ids if ids.count(step_id) > 1})
    reasons = []

    valid_scope_ranks = all(step["scope"] in ranks for step in steps)
    if not valid_scope_ranks:
        reasons.append("unknown scope rank")

    dependency_references_exist = all(dep in by_id for step in steps for dep in step["dependsOn"])
    if not dependency_references_exist:
        reasons.append("dependsOn references unknown step")

    no_forward_dependencies = True
    bottom_up_order = True
    for step in steps:
        for dep in step["dependsOn"]:
            if dep not in by_id:
                continue
            dep_step = by_id[dep]
            if dep_step["order"] >= step["order"]:
                no_forward_dependencies = False
                reasons.append(f"{step['id']} depends on non-prior step {dep}")
            if ranks[dep_step["scope"]] > ranks[step["scope"]] or dep_step["order"] >= step["order"]:
                bottom_up_order = False
                reasons.append(f"{step['id']} violates bottom-up dependency on {dep}")

    orders = [step["order"] for step in steps]
    deterministic_order = (
        len(set(orders)) == len(orders)
        and sorted(orders) == list(range(1, len(steps) + 1))
        and [step["id"] for step in sorted(steps, key=lambda item: item["order"])] == sorted(ids)
    )
    if not deterministic_order:
        reasons.append("step order is not deterministic")

    if duplicate_ids:
        reasons.append("duplicate step IDs")

    rejection_reasons = sorted(set(reasons))
    accepted = (
        valid_scope_ranks
        and dependency_references_exist
        and no_forward_dependencies
        and bottom_up_order
        and deterministic_order
        and not duplicate_ids
        and not rejection_reasons
    )

    return {
        "validScopeRanks": valid_scope_ranks,
        "dependencyReferencesExist": dependency_references_exist,
        "noForwardDependencies": no_forward_dependencies,
        "bottomUpOrder": bottom_up_order,
        "deterministicOrder": deterministic_order,
        "duplicateStepIDs": duplicate_ids,
        "rejectionReasons": rejection_reasons,
        "accepted": accepted,
    }

for name, steps in fixtures.items():
    validation = validate(steps)
    payload = {
        "patchStack": {
            "steps": steps,
            "accepted": validation["accepted"],
        },
        "patchStackValidation": validation,
    }
    (root / f"{name}.json").write_text(json.dumps(payload, indent=2) + "\n")
PY

validate_case() {
  local name="$1"
  if cue vet patchplan/cue/schema.cue patchplan/cue/patch-stack.cue "$tmp/$name.json" >"$tmp/$name.log" 2>&1; then
    printf true
  else
    printf false
  fi
}

good_cue_pass="$(validate_case good)"
top_down_cue_pass="$(validate_case top-down)"
forward_dependency_cue_pass="$(validate_case forward-dependency)"
scope_inversion_cue_pass="$(validate_case scope-inversion)"

python3 - "$tmp" "$out" "$good_cue_pass" "$top_down_cue_pass" "$forward_dependency_cue_pass" "$scope_inversion_cue_pass" <<'PY'
import json
import sys
from pathlib import Path

tmp = Path(sys.argv[1])
out = Path(sys.argv[2])
cue_results = {
    "good": sys.argv[3] == "true",
    "top-down": sys.argv[4] == "true",
    "forward-dependency": sys.argv[5] == "true",
    "scope-inversion": sys.argv[6] == "true",
}

def load(name):
    return json.loads((tmp / f"{name}.json").read_text())

def scope_order(steps):
    return [f"{step['order']}:{step['scope']}:{step['id']}" for step in sorted(steps, key=lambda item: item["order"])]

def dependency_order(steps):
    return [f"{dep}->{step['id']}" for step in steps for dep in step["dependsOn"]]

good = load("good")
good_report = {
    "slice": "patch-stack-plan",
    "case": "good",
    "accepted": cue_results["good"],
    "scopeOrder": scope_order(good["patchStack"]["steps"]),
    "dependencyOrder": dependency_order(good["patchStack"]["steps"]),
    "rejectionReasons": good["patchStackValidation"]["rejectionReasons"],
}

bad_cases = []
for name in ["top-down", "forward-dependency", "scope-inversion"]:
    payload = load(name)
    bad_cases.append({
        "case": name,
        "cueRejected": not cue_results[name],
        "accepted": cue_results[name],
        "scopeOrder": scope_order(payload["patchStack"]["steps"]),
        "dependencyOrder": dependency_order(payload["patchStack"]["steps"]),
        "rejectionReasons": payload["patchStackValidation"]["rejectionReasons"],
    })

bad_report = {
    "slice": "patch-stack-plan",
    "case": "bad",
    "accepted": False,
    "allRejected": all(case["cueRejected"] for case in bad_cases),
    "scopeOrder": bad_cases[0]["scopeOrder"],
    "dependencyOrder": bad_cases[0]["dependencyOrder"],
    "rejectionReasons": sorted({reason for case in bad_cases for reason in case["rejectionReasons"]}),
    "cases": bad_cases,
}

summary = {
    "slice": "patch-stack-plan",
    "accepted": good_report["accepted"] and bad_report["allRejected"],
    "goodAccepted": good_report["accepted"],
    "topDownRejected": bad_cases[0]["cueRejected"],
    "forwardDependencyRejected": bad_cases[1]["cueRejected"],
    "scopeInversionRejected": bad_cases[2]["cueRejected"],
    "scopeRank": {
        "symbol": 10,
        "file": 20,
        "package": 30,
        "module": 40,
        "workspace": 50,
    },
}

out.mkdir(parents=True, exist_ok=True)
(out / "patch-stack-plan-good.json").write_text(json.dumps(good_report, indent=2) + "\n")
(out / "patch-stack-plan-bad.json").write_text(json.dumps(bad_report, indent=2) + "\n")
(out / "patch-stack-plan-summary.json").write_text(json.dumps(summary, indent=2) + "\n")

(out / "patch-stack-plan-good.md").write_text("\n".join([
    "# Patch Stack Plan",
    "",
    "- case: good",
    f"- accepted: {str(good_report['accepted']).lower()}",
    f"- scope order: {', '.join(good_report['scopeOrder'])}",
    f"- dependency order: {', '.join(good_report['dependencyOrder'])}",
    "- rejection reasons: 0",
    "",
]))

bad_lines = [
    "# Patch Stack Plan",
    "",
    "- case: bad",
    f"- accepted: {str(bad_report['accepted']).lower()}",
    f"- all rejected: {str(bad_report['allRejected']).lower()}",
    "",
]
for case in bad_cases:
    bad_lines.extend([
        f"## {case['case']}",
        "",
        f"- CUE rejected: {str(case['cueRejected']).lower()}",
        f"- scope order: {', '.join(case['scopeOrder'])}",
        f"- dependency order: {', '.join(case['dependencyOrder'])}",
        f"- rejection reasons: {', '.join(case['rejectionReasons'])}",
        "",
    ])
(out / "patch-stack-plan-bad.md").write_text("\n".join(bad_lines))

(out / "patch-stack-plan-summary.md").write_text("\n".join([
    "# Patch Stack Plan Summary",
    "",
    f"- accepted: {str(summary['accepted']).lower()}",
    f"- good accepted: {str(summary['goodAccepted']).lower()}",
    f"- top-down rejected: {str(summary['topDownRejected']).lower()}",
    f"- forward dependency rejected: {str(summary['forwardDependencyRejected']).lower()}",
    f"- scope inversion rejected: {str(summary['scopeInversionRejected']).lower()}",
    "",
]))

if not summary["accepted"]:
    raise SystemExit(1)
PY

printf 'patch-stack-plan reports:\n'
printf '  patchplan/out/reports/patch-stack-plan-good.json\n'
printf '  patchplan/out/reports/patch-stack-plan-good.md\n'
printf '  patchplan/out/reports/patch-stack-plan-bad.json\n'
printf '  patchplan/out/reports/patch-stack-plan-bad.md\n'
printf '  patchplan/out/reports/patch-stack-plan-summary.json\n'
printf '  patchplan/out/reports/patch-stack-plan-summary.md\n'
