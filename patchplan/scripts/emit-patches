#!/usr/bin/env python3
import difflib
import json
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path


def usage() -> None:
    print("usage: patchplan/scripts/emit-patches <live-source> <candidate-source> <patch-plan.json> <patch-dir> <manifest.json>", file=sys.stderr)
    raise SystemExit(2)


def read_lines(path: Path) -> list[str]:
    if not path.exists():
        return []
    return path.read_text().splitlines(keepends=True)


def diff_file(rel: str, before: Path | None, after: Path | None) -> str:
    before_lines = read_lines(before) if before else []
    after_lines = read_lines(after) if after else []
    if before_lines == after_lines:
        return ""

    lines = [f"diff --git a/{rel} b/{rel}\n"]
    if before is None:
        lines.append("new file mode 100644\n")
        lines.append("--- /dev/null\n")
    else:
        lines.append(f"--- a/{rel}\n")
    if after is None:
        lines.append("deleted file mode 100644\n")
        lines.append("+++ /dev/null\n")
    else:
        lines.append(f"+++ b/{rel}\n")
    lines.extend(list(difflib.unified_diff(
        before_lines,
        after_lines,
        fromfile=f"a/{rel}",
        tofile=f"b/{rel}",
        lineterm="",
    ))[2:])
    return "".join(line if line.endswith("\n") else f"{line}\n" for line in lines)


def all_files(root: Path) -> set[str]:
    return {
        path.relative_to(root).as_posix()
        for path in root.rglob("*")
        if path.is_file()
    }


def write_patch(path: Path, live: Path, target: Path, rels: list[str]) -> dict[str, object]:
    patch_text = ""
    touched = []
    for rel in rels:
        before = live / rel
        after = target / rel
        before_path = before if before.exists() else None
        after_path = after if after.exists() else None
        file_diff = diff_file(rel, before_path, after_path)
        if file_diff:
            patch_text += file_diff
            touched.append(rel)
    path.write_text(patch_text)
    added = sum(1 for line in patch_text.splitlines() if line.startswith("+") and not line.startswith("+++"))
    removed = sum(1 for line in patch_text.splitlines() if line.startswith("-") and not line.startswith("---"))
    return {
        "touchedPaths": touched,
        "addedLineCount": added,
        "removedLineCount": removed,
        "text": patch_text,
    }


def apply_check(live: Path, patch_paths: list[Path]) -> bool:
    with tempfile.TemporaryDirectory(prefix="patchplan-apply-check.") as tmp:
        work = Path(tmp) / "work"
        shutil.copytree(live, work)
        for patch in patch_paths:
            patch_path = patch.resolve()
            check = subprocess.run(["git", "apply", "--check", str(patch_path)], cwd=work, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            if check.returncode != 0:
                return False
            apply = subprocess.run(["git", "apply", str(patch_path)], cwd=work, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            if apply.returncode != 0:
                return False
    return True


def main() -> int:
    if len(sys.argv) != 6:
        usage()
    live = Path(sys.argv[1])
    candidate = Path(sys.argv[2])
    patch_plan_path = Path(sys.argv[3])
    patch_dir = Path(sys.argv[4])
    manifest_path = Path(sys.argv[5])

    patch_plan = json.loads(patch_plan_path.read_text())["patchPlan"] if "patchPlan" in json.loads(patch_plan_path.read_text()) else json.loads(patch_plan_path.read_text())
    layers_by_id = {layer["id"]: layer for layer in patch_plan["patchLayers"]}

    patch_dir.mkdir(parents=True, exist_ok=True)
    for old in patch_dir.glob("*.patch"):
        old.unlink()

    stage1 = Path(tempfile.mkdtemp(prefix="patchplan-stage1."))
    try:
        shutil.copytree(live, stage1, dirs_exist_ok=True)
        logger_candidate = candidate / "src/logger.ts"
        if logger_candidate.exists():
            (stage1 / "src").mkdir(parents=True, exist_ok=True)
            shutil.copy2(logger_candidate, stage1 / "src/logger.ts")

        all_stage1 = sorted(all_files(live) | all_files(stage1))
        all_candidate = sorted(all_files(stage1) | all_files(candidate))
        patch1_rels = [rel for rel in all_stage1 if rel == "src/logger.ts"]
        patch2_rels = [rel for rel in all_candidate if rel != "src/logger.ts"]

        patch1 = patch_dir / "001-provide-logger-binding.patch"
        patch2 = patch_dir / "002-rewrite-console-calls.patch"
        meta1 = write_patch(patch1, live, stage1, patch1_rels)
        meta2 = write_patch(patch2, stage1, candidate, patch2_rels)
        apply_ok = apply_check(live, [patch1, patch2])

        patch1_text = str(meta1["text"])
        patch2_text = str(meta2["text"])
        manifest = {
            "patchManifest": {
                "patches": [
                    {
                        "path": patch1.relative_to(Path.cwd()).as_posix() if patch1.is_absolute() else patch1.as_posix(),
                        "layerID": "001-provide-logger-binding",
                        "obligations": layers_by_id["001-provide-logger-binding"]["obligations"],
                        "touchedPaths": meta1["touchedPaths"],
                        "addedLineCount": meta1["addedLineCount"],
                        "removedLineCount": meta1["removedLineCount"],
                        "evidence": {
                            "hasLoggerExport": "export const logger" in patch1_text,
                            "hasLoggerRewrite": False,
                        },
                    },
                    {
                        "path": patch2.relative_to(Path.cwd()).as_posix() if patch2.is_absolute() else patch2.as_posix(),
                        "layerID": "002-rewrite-console-calls",
                        "obligations": layers_by_id["002-rewrite-console-calls"]["obligations"],
                        "touchedPaths": meta2["touchedPaths"],
                        "addedLineCount": meta2["addedLineCount"],
                        "removedLineCount": meta2["removedLineCount"],
                        "evidence": {
                            "hasLoggerExport": False,
                            "hasLoggerRewrite": "logger.log" in patch2_text or "logger.error" in patch2_text,
                        },
                    },
                ],
                "applyCheck": {
                    "ordered": True,
                    "ok": apply_ok,
                },
            }
        }
        manifest_path.parent.mkdir(parents=True, exist_ok=True)
        manifest_path.write_text(json.dumps(manifest, indent=2) + "\n")
    finally:
        shutil.rmtree(stage1, ignore_errors=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
